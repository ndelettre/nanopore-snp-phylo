/*
========================================================================================
    NEXTFLOW.CONFIG — Configuration du pipeline (v2.1 corrigé)
========================================================================================
    LEÇON : Ce fichier est lu automatiquement par Nextflow au démarrage.
    Il définit :
      1. Les ressources par label (CPU, RAM, temps)
      2. Le budget total d'exécution (executor)
      3. Les profils d'exécution (local, docker, epi2me)
      4. La compatibilité EPI2ME
========================================================================================
*/

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : manifest définit les métadonnées du pipeline.
// EPI2ME utilise ces informations pour afficher le pipeline dans son interface.
// ─────────────────────────────────────────────────────────────────────────────

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
params.outdir     = "output"
params.resultsdir = "results"

manifest {
    name            = 'ndelettre/nanopore-snp-phylo'
    author          = 'Ton Nom'
    description     = 'Pipeline SNP et phylogénie pour Nanopore MinION - compatible EPI2ME'
    version         = '1.2.0'
    nextflowVersion = '>=22.10.0'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/ndelettre/nanopore-snp-phylo'
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : executor définit le budget total de ressources que Nextflow
// peut utiliser simultanément sur toutes les tâches en cours.
// Il ne lancera jamais plus de tâches que ce quota ne le permet.
//
// Exemple : avec cpus = 20 et deux tâches de 12 CPUs chacune,
// Nextflow lancera la première, puis attendra que des CPUs se libèrent
// avant de lancer la seconde.
// ─────────────────────────────────────────────────────────────────────────────
executor {
    name    = 'local'
    cpus    = 20        // Budget total CPUs (adapte à ta machine)
    memory  = '48 GB'   // Budget total RAM (adapte selon ta RAM disponible)
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : Les "labels" sont des groupes de ressources.
// On les associe aux process avec la directive "label" dans chaque module.
// Nextflow alloue alors les ressources définies ici à ces process.
// La variable task.cpus dans les scripts reflète automatiquement ces valeurs.
//
// CORRECTION v2.2 (bug bloquant v2.1) : dans la v2.1, les blocs `withLabel`
// étaient dupliqués. Le second bloc (scaling mémoire) écrasait entièrement
// le premier (qui définissait cpus/memory/time). Résultat : Nextflow perdait
// les directives `cpus` et `time` pour process_medium et process_high,
// et seul `memory` (avec task.attempt) était conservé.
//
// Solution : on fusionne tout dans un seul bloc par label, et on utilise
// une closure pour la mémoire afin d'avoir le scaling au retry.
// ─────────────────────────────────────────────────────────────────────────────
process {

    // Stratégie d'erreur conditionnelle : retry UNIQUEMENT sur les erreurs
    // transitoires (OOM killer = 137, segfault = 139, SIGTERM timeout = 143).
    // Pour les vraies erreurs logiques (exit 1, 2...), on s'arrête proprement
    // avec 'finish' qui laisse les autres tâches se terminer.
    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Tâches monothread : NanoStat, Bracken
    withLabel: 'process_mono' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '1 h'
    }

    // Tâches légères : Chopper, Medaka, Qualimap, QUAST, MLST, MultiQC,
    // rapport phylogénétique
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '1 h'
    }

    // Tâches moyennes : Flye, CheckM2, IQ-TREE, Kraken2 (4 CPU / 12 GB, voir plus bas)
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '4 h'
    }

    // Tâches lourdes : kSNP4
    withLabel: 'process_high' {
        cpus   = 20
        memory = { 48.GB * task.attempt }
        time   = '24 h'
    }

            withName: 'CHOPPER'  { container = 'quay.io/biocontainers/chopper:0.9.0--hdcf5f25_0' }
            withName: 'NANOSTAT' { container = 'quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0' }
            withName: 'FLYE'     { container = 'staphb/flye:2.9.6' }
            withName: 'MEDAKA'   { container = 'staphb/medaka:2.2.1' }
            withName: 'KSNP4'    { 
                container = 'staphb/ksnp4:4.0' 
                containerOptions = '-v /data/ksnp_cache:/kSNP'
            }
            withName: 'IQTREE'   { container = 'staphb/iqtree2:2.4.0' }
            withName: 'MULTIQC'  { container = 'staphb/multiqc:1.34' }
            withName: 'QUALIMAP' { container = 'quay.io/biocontainers/qualimap:2.3--hdfd78af_0' }
            withName: 'PHYLO_REPORT' { container = 'nicolasdelettre/phyloreport:1.0.1' }
            // Kraken2 : 4 CPU suffisent, le temps passant surtout à charger la base.
            // 12 GB = base PlusPF-8 chargée en RAM (7,5 GB) + marge.
            // LEÇON : withName est prioritaire sur withLabel → ces valeurs
            // remplacent celles de process_medium.
            // maxForks = 1 : un seul Kraken2 à la fois. Sans ça, Nextflow lance
            // en premier les Kraken2 (4 CPU, faciles à caser) de toutes les
            // souches et Flye (8 CPU) attend. Ainsi, Kraken2 n'occupe jamais
            // plus de 4 CPU et deux Flye peuvent tourner à côté (2 × 8 + 4 = 20).
            // Bonus : une seule copie de la base en RAM.
            withName: 'KRAKEN2|KRAKEN2_REFERENCE' {
                container = 'staphb/kraken2:2.1.3'
                cpus      = 4
                memory    = { 12.GB * task.attempt }
                maxForks  = 1
            }
            withName: 'BRACKEN' { container = 'staphb/bracken:3.1' }
            withName: 'MLST' { container = 'staphb/mlst:2.23.0' }
            withName: 'QUAST' { container = 'staphb/quast:5.2.0' }
            withName: 'CHECKM2' { container = 'staphb/checkm2:1.0.2' }

}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : Les profils permettent de changer l'environnement d'exécution
// sans modifier le code du pipeline.
//
// Utilisation :
//   nextflow run main.nf -profile docker    ← avec Docker (recommandé)
//   nextflow run main.nf -profile local     ← outils installés dans le PATH
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // ─────────────────────────────────────────────────────────────────────────
    // Profil local : les outils doivent être installés dans le PATH du système
    // ─────────────────────────────────────────────────────────────────────────
    local {
        process.executor = 'local'
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Profil Docker : chaque process s'exécute dans un conteneur isolé.
    // Nextflow télécharge automatiquement les images au premier lancement.
    // Les images sont ensuite mises en cache localement.
    // Avantage : reproductibilité totale, pas de problème de dépendances.
    //
    // CORRECTION v2.1 (bug bloquant config) : `docker.userEmulation = true`
    // est DÉPRÉCIÉ depuis Nextflow 23.09 et sera supprimé. La bonne façon
    // est d'utiliser `docker.runOptions` pour passer l'UID/GID de l'hôte
    // au conteneur, afin que les fichiers produits soient propriétés de
    // l'utilisateur et non de root.
    // ─────────────────────────────────────────────────────────────────────────
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Profil EPI2ME : configuration optimisée pour EPI2ME Desktop.
    // Oxford Nanopore Technologies utilise Nextflow en arrière-plan dans EPI2ME.
    // Pour intégrer ce pipeline : EPI2ME Desktop → Import Local Workflow.
    // ─────────────────────────────────────────────────────────────────────────
    epi2me {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor  = 'local'
        process {
            withLabel: 'process_high' { time = '48 h' }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : Configuration du dossier de travail temporaire de Nextflow.
// Nextflow crée un dossier "work/" avec des sous-dossiers pour chaque tâche.
// En cas d'erreur, inspecte ces dossiers pour voir les logs :
//   cat work/xx/yyyyyyyy/.command.err
//   cat work/xx/yyyyyyyy/.command.log
// ─────────────────────────────────────────────────────────────────────────────
workDir = 'work'

// ─────────────────────────────────────────────────────────────────────────────
// LEÇON : Rapports Nextflow générés automatiquement à la fin du pipeline.
// - pipeline_report.html   → détails de chaque tâche (CPU, RAM, durée)
// - pipeline_timeline.html → chronologie d'exécution visuelle
// - pipeline_dag.svg       → graphe du pipeline (DAG = Directed Acyclic Graph)
// ─────────────────────────────────────────────────────────────────────────────
report   { enabled = true; file = "${params.outdir}/pipeline_report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_dag.svg";       overwrite = true }
